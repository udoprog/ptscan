<?xml version="1.0" encoding="windows-1252"?>
<Wix xmlns="http://schemas.microsoft.com/wix/2006/wi">
  <Product Id="*" Name="ptscan" UpgradeCode="D6C2DB82-4A95-4F77-B135-C5AE1C5D26D0" Manufacturer="John-John Tedro" Language="1033" Codepage="1252" Version="$(var.Version)">
    <Package Id="*" Keywords="Installer" Manufacturer="John-John Tedro" InstallerVersion="450" Languages="1033" Compressed="yes" InstallScope="perMachine" SummaryCodepage="1252" Platform="$(var.Platform)"/>

    <MajorUpgrade
      AllowDowngrades="no"
      AllowSameVersionUpgrades="no"
      DowngradeErrorMessage="A newer version of [ProductName] is already installed. Setup will now exit."
      />

    <Media Id="1" Cabinet="media1.cab" EmbedCab="yes" DiskPrompt="CD-ROM #1"/>
    <Property Id="DiskPrompt" Value="ptscan Installation"/>

    <Directory Id="TARGETDIR" Name="SourceDir">
      <Directory Id="ProgramMenuFolder">
        <Directory Id="ApplicationProgramsFolder" Name="ptscan">
          <Component Id="ApplicationShortcut" Guid="{95AC78A3-EDB6-4544-AAEF-E4FF18FBCFA1}" Win64="$(var.Win64)">
            <Shortcut Id="ApplicationStartMenuShortcut" Name="ptscan" Description="ptscan memory scanner by John-John Tedro" Target="[!$(var.BinaryName)]" WorkingDirectory="APPLICATIONFOLDER" />
            <RemoveFolder Id="CleanUpShortCut" Directory="ApplicationProgramsFolder" On="uninstall"/>
            <RegistryValue Root="HKCU" Key="Software\ptscan" Name="installed" Type="integer" Value="1" KeyPath="yes"/>
          </Component>
        </Directory>
      </Directory>

      <Directory Id="$(var.ProgramFilesFolder)" Name="PFiles">
        <Directory Id="APPLICATIONFOLDER" Name="ptscan">
          <Component Id="$(var.BinaryName)" Guid="{26B75FB8-D439-41AB-8EEC-2E1D8195CD6E}" Win64="$(var.Win64)">
            <File Id="$(var.BinaryName)" Name="$(var.BinaryName)" DiskId="1" Source="$(var.BinaryPath)" KeyPath="yes"/>
          </Component>
        </Directory>
      </Directory>
    </Directory>

    <Feature Id="MainProgram" Title="ptscan" Description="Installs ptscan." Level="1" ConfigurableDirectory="APPLICATIONFOLDER" AllowAdvertise="no" Display="expand" Absent="disallow">
      <ComponentRef Id="$(var.BinaryName)"/>
      <ComponentRef Id="ApplicationShortcut"/>
    </Feature>

    <SetProperty Id="ARPINSTALLLOCATION" Value="[APPLICATIONFOLDER]" After="CostFinalize"/>

    <Property Id="ARPHELPLINK" Value="https://github.com/udoprog/ptscan"/>

    <UI>
      <UIRef Id="WixUI_FeatureTree"/>

      <Publish Dialog="ExitDialog" Control="Finish" Event="DoAction" Value="LaunchApplication">WIXUI_EXITDIALOGOPTIONALCHECKBOX = 1 and NOT Installed</Publish>
    </UI>

    <Property Id="WIXUI_EXITDIALOGOPTIONALCHECKBOXTEXT" Value="Launch ptscan" />
    <Property Id="WIXUI_EXITDIALOGOPTIONALCHECKBOX" Value="1" />
    <Property Id="WixShellExecTarget" Value="[#$(var.BinaryName)]" />
    <CustomAction Id="LaunchApplication" BinaryKey="WixCA" DllEntry="WixShellExec" Impersonate="yes" />
  </Product>
</Wix>